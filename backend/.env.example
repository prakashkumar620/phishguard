# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/phishguard?retryWrites=true&w=majority
# Set to true to automatically launch an in-memory MongoDB instance for offline local testing/dev
USE_MEMORY_DB_FALLBACK=true

# JWT Authentication
JWT_SECRET=replace_this_with_a_super_secret_64_char_random_key_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Optional Threat Intelligence (Google Safe Browsing API v4)
# Leave empty to run with heuristic and ML detection only
GOOGLE_SAFE_BROWSING_API_KEY=

# ML Service Settings
PYTHON_PATH=python
ML_MODEL_PATH=../ml/models/phishing_model.joblib
